# ====================================================================
# MailGuardian AI / SecureX Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR OWN API KEYS
# ====================================================================

# Application Settings
APP_NAME=MailGuardianAI
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Threat Intelligence API Keys (Free tier / Community keys)
# Get key at https://www.virustotal.com/gui/join-us (comma-separated for key rotation)
VIRUSTOTAL_API_KEYS=your_virustotal_key_1,your_virustotal_key_2

# Get key at https://www.abuseipdb.com/register
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# Get key at https://otx.alienvault.com/api
ALIENVAULT_OTX_API_KEY=your_alienvault_otx_api_key_here

# Geolocation API (Token optional for higher limits: https://ipinfo.io/)
IPINFO_TOKEN=your_ipinfo_token_here

# Threat Intelligence Cache TTL (Seconds)
CACHE_TTL_SECONDS=604800
CACHE_TTL_DAYS=7
WHOIS_CACHE_TTL=604800
GEO_CACHE_TTL=604800

# OpenRouter AI Configuration (Primary LLM Engine)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct

# Google Gemini Fallback Keys (Multi-tier Failover Rotation)
GEMINI_API_KEY_1=your_gemini_api_key_1_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here
GEMINI_API_KEY_3=your_gemini_api_key_3_here
GEMINI_PRIMARY_MODEL=gemini-2.5-flash
GEMINI_DOWNGRADE_MODEL=gemini-2.5-flash
